# Copy this file to .env (or .env.local) and fill in the values you need.
# terch works with zero configuration (DuckDuckGo backend), these are only
# required if you want to use the Google Custom Search provider (-p google).

# Google Custom Search JSON API key: https://developers.google.com/custom-search/v1/introduction
GOOGLE_API_KEY=

# Google Programmable Search Engine ID (cx): https://programmablesearchengine.google.com/
GOOGLE_CX_ID=
